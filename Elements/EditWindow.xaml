<Window x:Class="Constructors_Шаповалова.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование студента" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фамилия:" Margin="0,5"/>
        <TextBox x:Name="tb_lastname" Grid.Row="0" Margin="80,5,0,5"/>

        <TextBlock Text="Имя:" Grid.Row="1" Margin="0,5"/>
        <TextBox x:Name="tb_firstname" Grid.Row="1" Margin="80,5,0,5"/>

        <TextBlock Text="Отчество:" Grid.Row="2" Margin="0,5"/>
        <TextBox x:Name="tb_surname" Grid.Row="2" Margin="80,5,0,5"/>

        <TextBlock Text="Курс:" Grid.Row="3" Margin="0,5"/>
        <TextBox x:Name="tb_course" Grid.Row="3" Margin="80,5,0,5"/>

        <CheckBox x:Name="cb_scholarship" Content="Получает стипендию" Grid.Row="4" Margin="80,10,0,5"/>

        <Button Content="Сохранить" Grid.Row="6" Width="100" Height="30" HorizontalAlignment="Right" Click="BtnSave_Click"/>
    </Grid>
</Window>