<UserControl x:Class="Constructors_Шаповалова.Elements.Search"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Constructors_Шаповалова.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="620,10,0,400">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="tb_search" Grid.Column="0" VerticalContentAlignment="Center" Background="Bisque"/>
        <Button x:Name="btn_search" Grid.Column="1" Content="Найти" Background="White" Click="btnsearch"/>
    </Grid>
</UserControl>
